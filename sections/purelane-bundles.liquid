{%- comment -%}
  sections/purelane-bundles.liquid
  ─────────────────────────────────────────────────────────────────────
  Build-your-bundle tier cards (2 / 3 / 5 products).

  CHANGELOG vs prototype:
    • Static 3 tier articles → up to 3 theme blocks (add/remove/reorder in editor)
    • Tier prices are block settings — tradeoff documented:
        "Multi-product bundle prices have no native Shopify equivalent without
         a bundles app. Block settings are the defensible zero-dependency approach.
         Upgrade path: create a Shopify product per bundle tier, use product.price."
    • tierpix product images use real <img> from block.settings.product_N
    • "Build this box" CTA URL is a block setting (Q3 recommendation C)
    • benefit_1–3 text fields render the checklist; blank items are hidden
    • .best highlighted tier driven by block.settings.highlight
    • Adding/removing/reordering blocks does not break layout (CSS grid)
{%- endcomment -%}

{%- assign sid = section.id -%}

{{- 'purelane.css' | asset_url | stylesheet_tag -}}

<style>
#pl-bundles-{{ sid }} {
  position: relative; z-index: 2; padding: var(--pl-sec-y) 0;
}
.pl-bundles-wrap-{{ sid }} {
  max-width: 1180px; margin: 0 auto; padding: 0 18px;
}

/* Tier grid */
.pl-tiers-{{ sid }} {
  display: grid; gap: 14px; grid-template-columns: 1fr;
}
@media (min-width: 760px) {
  .pl-tiers-{{ sid }} { grid-template-columns: repeat(3, 1fr); }
}

/* Individual tier */
.pl-tier-{{ sid }} {
  padding: 24px 22px;
  transition: .4s var(--pl-ease);
  display: flex; flex-direction: column;
}
.pl-tier-{{ sid }}:hover { transform: translateY(-5px); }
.pl-tier-{{ sid }}.pl-tier--best {
  border-color: rgba(201,118,29,.46) !important;
  box-shadow: 0 22px 54px rgba(58,44,112,.14), 0 0 0 1px rgba(201,118,29,.24), var(--pl-g-inset) !important;
}

/* Tag pill */
.pl-tier-tag-{{ sid }} {
  display: inline-block;
  font-size: 9.5px; font-weight: 800; letter-spacing: .16em; text-transform: uppercase;
  padding: 5px 11px; border-radius: 999px; margin-bottom: 14px;
  background: rgba(201,118,29,.14); border: 1px solid rgba(201,118,29,.34); color: #4f7d10;
}

/* Product preview row */
.pl-tierpix-{{ sid }} {
  display: flex; align-items: flex-end; justify-content: center;
  gap: 2px; height: 78px; margin: -4px 0 16px;
  padding: 8px 6px; border-radius: 14px;
  background: linear-gradient(162deg, rgba(255,255,255,.54), rgba(236,230,247,.34));
  border: 1px solid rgba(75,58,143,.11);
}
.pl-tierpix-{{ sid }} img {
  height: 62px; width: auto; object-fit: contain;
  filter: drop-shadow(0 5px 8px rgba(0,74,66,.13));
}
.pl-tierpix-{{ sid }}.pl-tierpix--five img { height: 54px; }

/* Quantity display */
.pl-tier-qty-{{ sid }} {
  font-family: 'Outfit', sans-serif; font-weight: 800;
  font-size: 52px; line-height: .9; color: var(--pl-surface); letter-spacing: -.03em;
}
.pl-tier-qty-{{ sid }} small {
  font-size: 14px; font-weight: 600; letter-spacing: .1em; text-transform: uppercase;
  color: var(--pl-paper-3); display: block; margin-top: 6px;
}

/* Price */
.pl-tier-price-{{ sid }} {
  font-family: 'Outfit', sans-serif; font-weight: 700;
  font-size: 27px; color: var(--pl-accent); margin: 16px 0 4px;
}
.pl-tier-price-{{ sid }} s {
  font-size: 14px; color: var(--pl-paper-3); font-weight: 500; margin-left: 8px;
}

/* Benefits list */
.pl-tier-{{ sid }} ul {
  list-style: none; margin: 16px 0 20px; display: grid; gap: 8px; flex: 1;
}
.pl-tier-{{ sid }} li {
  display: flex; gap: 9px; font-size: 13px; color: var(--pl-paper-2);
}
.pl-tier-{{ sid }} li svg { width: 14px; height: 14px; color: #4f7d10; flex: 0 0 auto; margin-top: 4px; }

/* CTA */
.pl-tier-{{ sid }} .pl-btn { width: 100%; justify-content: center; margin-top: auto; }

@media (max-width: 760px) {
  .pl-tier-qty-{{ sid }} { font-size: 44px; }
  .pl-tierpix-{{ sid }} { height: 70px; }
  .pl-tierpix-{{ sid }} img { height: 54px; }
  .pl-tierpix-{{ sid }}.pl-tierpix--five img { height: 46px; }
}
</style>

<section id="pl-bundles-{{ sid }}" class="pl-sec" data-pl-scene="3">
  <div class="pl-bundles-wrap-{{ sid }}">

    {%- comment -%}── HEADER ──{%- endcomment -%}
    <div class="pl-glass pl-sec-pad pl-rv" style="margin-bottom:16px;">
      <div class="pl-panel-head" style="margin-bottom:0">
        {%- if section.settings.kicker != blank -%}
          <span class="pl-kicker">{{ section.settings.kicker }}</span>
        {%- endif -%}
        {%- if section.settings.heading != blank -%}
          <h2 class="pl-d2" style="margin-top:12px">{{ section.settings.heading }}</h2>
        {%- endif -%}
        {%- if section.settings.subheading != blank -%}
          <p class="pl-lede" style="margin:0 auto">{{ section.settings.subheading }}</p>
        {%- endif -%}
      </div>
    </div>

    {%- comment -%}── TIER GRID ──{%- endcomment -%}
    <div class="pl-tiers-{{ sid }}">
      {%- for block in section.blocks -%}
        {%- liquid
          assign tier_products = block.settings.product_1, block.settings.product_2, block.settings.product_3, block.settings.product_4, block.settings.product_5
          assign tier_prod_count = 0
          for tp in tier_products
            if tp; assign tier_prod_count = tier_prod_count | plus: 1; endif
          endfor

          assign delay_arr = 'pl-rv-d1,pl-rv-d2,pl-rv-d3' | split: ','
          assign tier_delay = delay_arr[forloop.index0]
        -%}

        <article class="pl-glass pl-tier-{{ sid }} pl-rv {{ tier_delay }}{% if block.settings.highlight %} pl-tier--best{% endif %}"
          {{ block.shopify_attributes }}>

          {%- if block.settings.tag_label != blank -%}
            <span class="pl-tier-tag-{{ sid }}">{{ block.settings.tag_label }}</span>
          {%- endif -%}

          {%- comment -%} Product preview images {%- endcomment -%}
          <div class="pl-tierpix-{{ sid }}{% if tier_prod_count >= 5 %} pl-tierpix--five{% endif %}"
            aria-hidden="true">
            {%- for tp in tier_products -%}
              {%- if tp and tp.featured_image -%}
                <img
                  src="{{ tp.featured_image | image_url: width: 120 }}"
                  alt="{{ tp.featured_image.alt | default: tp.title | escape }}"
                  width="60" height="62"
                  loading="lazy">
              {%- elsif tp -%}
                <div style="width:40px;height:62px;border-radius:8px;background:linear-gradient(160deg,rgba(255,255,255,.5),rgba(236,230,247,.3));"></div>
              {%- endif -%}
            {%- endfor -%}
          </div>

          {%- comment -%} Quantity {%- endcomment -%}
          <div class="pl-tier-qty-{{ sid }}">
            {{ block.settings.quantity | default: tier_prod_count | default: '?' }}
            <small>Product{% if block.settings.quantity != 1 %}s{% endif %}</small>
          </div>

          {%- comment -%} Price {%- endcomment -%}
          <div class="pl-tier-price-{{ sid }}">
            {{ block.settings.price }}
            {%- if block.settings.compare_price != blank -%}
              <s>{{ block.settings.compare_price }}</s>
            {%- endif -%}
          </div>
          {%- if block.settings.per_product_note != blank -%}
            <p class="pl-body-s" style="font-size:12px">{{ block.settings.per_product_note }}</p>
          {%- endif -%}

          {%- comment -%} Benefits checklist {%- endcomment -%}
          {%- assign has_benefits = false -%}
          {%- for i in (1..3) -%}
            {%- assign b_key = 'benefit_' | append: i -%}
            {%- if block.settings[b_key] != blank -%}{%- assign has_benefits = true -%}{%- endif -%}
          {%- endfor -%}
          {%- if has_benefits -%}
            <ul>
              {%- for i in (1..3) -%}
                {%- assign b_key = 'benefit_' | append: i -%}
                {%- if block.settings[b_key] != blank -%}
                  <li>
                    {%- render 'purelane-icon-check' -%}
                    {{ block.settings[b_key] | escape }}
                  </li>
                {%- endif -%}
              {%- endfor -%}
            </ul>
          {%- endif -%}

          {%- comment -%} CTA {%- endcomment -%}
          {%- if block.settings.cta_label != blank -%}
            <a href="{{ block.settings.cta_url | default: '#' }}"
              class="pl-btn {% if block.settings.cta_style == 'btn-primary' %}pl-btn-primary{% else %}pl-btn-ghost{% endif %}">
              {{ block.settings.cta_label }}
              {%- if block.settings.cta_style == 'btn-primary' -%}
                {%- render 'purelane-icon-arrow' -%}
              {%- endif -%}
            </a>
          {%- endif -%}

        </article>
      {%- endfor -%}
    </div>

  </div>
</section>

{{ 'purelane-sections.js' | asset_url | script_tag }}

{% schema %}
{
  "name": "Purelane — Bundle tiers",
  "tag": "section",
  "class": "purelane-bundles",
  "settings": [
    {
      "type": "text",
      "id": "kicker",
      "label": "Kicker label",
      "default": "Build your bundle"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "One box. Every room."
    },
    {
      "type": "text",
      "id": "subheading",
      "label": "Subheading",
      "default": "Mix and match across kitchen, laundry, home and skin. One flat price, no code needed, free shipping either way."
    }
  ],
  "blocks": [
    {
      "type": "tier",
      "name": "Bundle tier",
      "limit": 3,
      "settings": [
        {
          "type": "header",
          "content": "Tier identity"
        },
        {
          "type": "text",
          "id": "tag_label",
          "label": "Tag label",
          "default": "Starter"
        },
        {
          "type": "number",
          "id": "quantity",
          "label": "Quantity displayed",
          "default": 2,
          "info": "Large number shown on the card (e.g. 2, 3, 5)."
        },
        {
          "type": "checkbox",
          "id": "highlight",
          "label": "Highlight (gold border)",
          "default": false
        },
        {
          "type": "header",
          "content": "Products shown in preview row"
        },
        {
          "type": "product",
          "id": "product_1",
          "label": "Product 1"
        },
        {
          "type": "product",
          "id": "product_2",
          "label": "Product 2"
        },
        {
          "type": "product",
          "id": "product_3",
          "label": "Product 3"
        },
        {
          "type": "product",
          "id": "product_4",
          "label": "Product 4"
        },
        {
          "type": "product",
          "id": "product_5",
          "label": "Product 5"
        },
        {
          "type": "header",
          "content": "Pricing"
        },
        {
          "type": "text",
          "id": "price",
          "label": "Bundle price",
          "default": "₹349",
          "info": "Multi-product bundle price. Enter manually. Upgrade path: create a Shopify product per tier and wire to product.price."
        },
        {
          "type": "text",
          "id": "compare_price",
          "label": "Compare-at price",
          "default": "₹598"
        },
        {
          "type": "text",
          "id": "per_product_note",
          "label": "Per-product note",
          "default": "Flat ₹174 per product"
        },
        {
          "type": "header",
          "content": "Benefits (checklist)"
        },
        {
          "type": "text",
          "id": "benefit_1",
          "label": "Benefit 1",
          "default": "Pick any two products"
        },
        {
          "type": "text",
          "id": "benefit_2",
          "label": "Benefit 2",
          "default": "Free shipping across India"
        },
        {
          "type": "text",
          "id": "benefit_3",
          "label": "Benefit 3 (optional)"
        },
        {
          "type": "header",
          "content": "Call to action"
        },
        {
          "type": "text",
          "id": "cta_label",
          "label": "Button label",
          "default": "Build this box"
        },
        {
          "type": "url",
          "id": "cta_url",
          "label": "Button URL",
          "info": "Where does this tier's CTA link? Set to a bundle landing page, collection, or any URL. (Q3 decision: URL setting — no app required.)"
        },
        {
          "type": "select",
          "id": "cta_style",
          "label": "Button style",
          "options": [
            { "value": "btn-ghost",   "label": "Ghost (outline)" },
            { "value": "btn-primary", "label": "Primary (filled)" }
          ],
          "default": "btn-ghost"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Purelane — Bundle tiers",
      "blocks": [
        {
          "type": "tier",
          "settings": {
            "tag_label": "Starter",
            "quantity": 2,
            "price": "₹349",
            "compare_price": "₹598",
            "per_product_note": "Flat ₹174 per product",
            "benefit_1": "Pick any two products",
            "benefit_2": "Free shipping across India",
            "cta_label": "Build this box",
            "cta_style": "btn-ghost"
          }
        },
        {
          "type": "tier",
          "settings": {
            "tag_label": "Most popular",
            "quantity": 3,
            "highlight": true,
            "price": "₹499",
            "compare_price": "₹897",
            "per_product_note": "Flat ₹166 per product",
            "benefit_1": "Pick any three products",
            "benefit_2": "Covers kitchen and laundry",
            "benefit_3": "Free shipping across India",
            "cta_label": "Build this box",
            "cta_style": "btn-primary"
          }
        },
        {
          "type": "tier",
          "settings": {
            "tag_label": "Whole home",
            "quantity": 5,
            "price": "₹799",
            "compare_price": "₹1,495",
            "per_product_note": "Flat ₹160 per product",
            "benefit_1": "Pick any five products",
            "benefit_2": "Every room in one order",
            "benefit_3": "Free shipping across India",
            "cta_label": "Build this box",
            "cta_style": "btn-ghost"
          }
        }
      ]
    }
  ]
}
{% endschema %}
