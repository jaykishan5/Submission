{%- comment -%}
  sections/purelane-combos.liquid
  ─────────────────────────────────────────────────────────────────────
  Best-selling combos horizontal scroll rail.

  CHANGELOG vs prototype:
    • Each combo card is now a theme editor block (merchant can add/remove/reorder)
    • Product images in the stack tray use real <img> from block.settings.product_N
    • Combo prices are block settings (not product prices) — documented tradeoff:
        Bundle prices span multiple products and have no native Shopify equivalent
        without a bundles app. Block settings are the most defensible zero-dependency
        solution. To upgrade: wire price/compare_price to a bundle product's
        price object and remove these settings.
    • Flag badge ("Most popular") is an optional text block setting —
        blank = badge hidden (Q2 recommendation A)
    • <article> used for each combo card (semantic improvement; prototype used <article>
        but without consistent section tagging)
    • comborail scrollbar hidden via CSS + aria-label on container for screen readers
{%- endcomment -%}

{%- assign sid = section.id -%}

{{- 'purelane.css' | asset_url | stylesheet_tag -}}

<style>
#pl-combos-{{ sid }} {
  position: relative; z-index: 2;
  padding: var(--pl-sec-y) 0;
}
.pl-combos-wrap-{{ sid }} {
  max-width: 1180px; margin: 0 auto; padding: 0 18px;
}

/* Rail */
.pl-comborail-{{ sid }} {
  display: flex;
  gap: 14px;
  overflow-x: auto;
  overflow-y: hidden;
  scroll-snap-type: x mandatory;
  margin: 0 -18px;
  padding: 4px 18px 14px;
  scrollbar-width: none;
  -webkit-overflow-scrolling: touch;
}
.pl-comborail-{{ sid }}::-webkit-scrollbar { display: none; }

/* Individual combo card */
.pl-combo-{{ sid }} {
  flex: 0 0 302px;
  scroll-snap-align: start;
  display: flex;
  flex-direction: column;
  padding: 0;
  transition: .4s var(--pl-ease);
}
.pl-combo-{{ sid }}:hover { transform: translateY(-5px); }
.pl-combo-{{ sid }}.pl-combo--hero {
  border-color: rgba(201,118,29,.46) !important;
  box-shadow: 0 22px 54px rgba(58,44,112,.14), 0 0 0 1px rgba(201,118,29,.24), var(--pl-g-inset) !important;
}

/* Tray (product images area) */
.pl-combo-tray-{{ sid }} {
  padding: 14px 14px 13px;
  border-bottom: 1px solid rgba(75,58,143,.12);
  position: relative;
  background: linear-gradient(162deg, rgba(255,255,255,.56), rgba(236,230,247,.34));
}
.pl-combo-save-{{ sid }} {
  display: inline-block;
  font-size: 9.5px; font-weight: 800; letter-spacing: .12em; text-transform: uppercase;
  padding: 5px 11px; border-radius: 999px;
  background: rgba(255,255,255,.84);
  border: 1px solid rgba(201,118,29,.34);
  color: #4f7d10;
  margin-bottom: 13px;
}
.pl-combo-flag-{{ sid }} {
  position: absolute; top: 14px; right: 14px;
  font-size: 8.6px; font-weight: 800; letter-spacing: .1em; text-transform: uppercase;
  padding: 5px 10px; border-radius: 999px;
  background: linear-gradient(135deg, #00706a, #004b46);
  color: #f4fdf6;
}

/* Stack (product image row) */
.pl-stack-{{ sid }} { display: flex; align-items: flex-end; gap: 3px; }
.pl-stack-{{ sid }} .pl-sit {
  flex: 1 1 0; min-width: 0; text-align: center;
}
.pl-stack-{{ sid }} .pl-sit img {
  height: 66px; width: auto; object-fit: contain;
  margin: 0 auto 8px;
  display: block;
  filter: drop-shadow(0 5px 8px rgba(0,74,66,.13));
}
.pl-stack-{{ sid }} .pl-sit .pl-sit-tile {
  height: 66px; width: 44px; margin: 0 auto 8px;
  display: grid; place-items: center; border-radius: 9px;
  background: rgba(255,255,255,.5);
  border: 1px dashed rgba(75,58,143,.26);
  color: #4f7d10;
}
.pl-stack-{{ sid }} .pl-sit .pl-sit-tile svg { width: 17px; height: 17px; }
.pl-stack-{{ sid }} .pl-sit span {
  display: block; font-size: 8.6px; line-height: 1.32;
  color: var(--pl-paper-2); font-weight: 600;
}
.pl-stack-{{ sid }} .pl-plus {
  flex: 0 0 9px; color: var(--pl-accent);
  font-weight: 800; font-size: 12px;
  padding-bottom: 30px; text-align: center;
}

/* Card body */
.pl-combo-body-{{ sid }} {
  padding: 15px 16px 18px;
  display: flex; flex-direction: column; flex: 1;
}
.pl-combo-body-{{ sid }} h3 {
  font-family: 'Outfit', sans-serif;
  font-size: 16px; font-weight: 700; text-transform: uppercase;
  letter-spacing: -.005em; line-height: 1.1; color: var(--pl-surface);
}
.pl-combo-cnt-{{ sid }} {
  font-size: 10.5px; font-weight: 700; letter-spacing: .12em; text-transform: uppercase;
  color: var(--pl-paper-3); margin-top: 6px;
}
.pl-combo-inc-{{ sid }} {
  font-size: 12.4px; color: var(--pl-paper-2); line-height: 1.55;
  margin: 11px 0 14px; flex: 1;
}
.pl-combo-prow-{{ sid }} {
  display: flex; align-items: baseline; gap: 9px; flex-wrap: wrap; margin-bottom: 6px;
}
.pl-combo-prow-{{ sid }} strong {
  font-family: 'Outfit', sans-serif; font-size: 25px; font-weight: 800;
  color: var(--pl-surface); letter-spacing: -.02em;
}
.pl-combo-prow-{{ sid }} s { font-size: 13px; color: var(--pl-paper-3); }
.pl-combo-prow-{{ sid }} em {
  font-style: normal; font-size: 9.5px; font-weight: 800; letter-spacing: .1em; text-transform: uppercase;
  padding: 4px 9px; border-radius: 999px;
  background: rgba(201,118,29,.14); border: 1px solid rgba(201,118,29,.34); color: #4f7d10;
}
.pl-combo-fine-{{ sid }} {
  font-size: 10.4px; color: var(--pl-paper-3); margin-bottom: 14px;
}

/* Rail utility */
.pl-swipecue-{{ sid }} {
  display: flex; align-items: center; justify-content: center; gap: 8px;
  font-size: 10px; font-weight: 700; letter-spacing: .16em; text-transform: uppercase;
  color: var(--pl-paper-3); margin-top: 2px;
}
.pl-swipecue-{{ sid }} svg { width: 14px; height: 14px; color: var(--pl-accent); }
.pl-railnote-{{ sid }} {
  text-align: center; font-size: 12px; color: var(--pl-paper-3);
  margin-top: 14px; max-width: 62ch; margin-left: auto; margin-right: auto;
}

@media (max-width: 760px) {
  .pl-combo-{{ sid }}          { flex: 0 0 268px; }
  .pl-stack-{{ sid }} .pl-sit img { height: 56px; }
  .pl-stack-{{ sid }} .pl-sit .pl-sit-tile { height: 56px; width: 38px; }
  .pl-comborail-{{ sid }}      { margin: 0 -14px; padding: 4px 14px 12px; }
}
</style>

<section id="pl-combos-{{ sid }}" class="pl-sec" data-pl-scene="3">
  <div class="pl-combos-wrap-{{ sid }}">

    <div class="pl-panel-head pl-rv">
      {%- if section.settings.kicker != blank -%}
        <span class="pl-kicker">{{ section.settings.kicker }}</span>
      {%- endif -%}
      {%- if section.settings.heading != blank -%}
        <h2 class="pl-d2" style="margin-top:12px">{{ section.settings.heading }}</h2>
      {%- endif -%}
      <div class="pl-rule" style="margin:10px auto 0;justify-content:center;">
        <i></i>{%- render 'purelane-icon-leaf' -%}<i></i>
      </div>
      {%- if section.settings.subheading != blank -%}
        <p class="pl-lede" style="margin:14px auto 0">{{ section.settings.subheading }}</p>
      {%- endif -%}
    </div>

    <div class="pl-comborail-{{ sid }} pl-rv" role="list" aria-label="Best selling combo packs">

      {%- for block in section.blocks -%}
        {%- liquid
          assign p1   = block.settings.product_1
          assign p2   = block.settings.product_2
          assign p3   = block.settings.product_3
          assign p4   = block.settings.product_4
          assign products_in_block = 0
          if p1;   assign products_in_block = products_in_block | plus: 1; endif
          if p2;   assign products_in_block = products_in_block | plus: 1; endif
          if p3;   assign products_in_block = products_in_block | plus: 1; endif
          if p4;   assign products_in_block = products_in_block | plus: 1; endif
        -%}

        <article class="pl-glass pl-combo-{{ sid }}{% if block.settings.highlight %} pl-combo--hero{% endif %}"
          role="listitem" {{ block.shopify_attributes }}>

          {%- comment -%}── TRAY (product images) ──{%- endcomment -%}
          <div class="pl-combo-tray-{{ sid }}">
            {%- if block.settings.save_label != blank -%}
              <span class="pl-combo-save-{{ sid }}">{{ block.settings.save_label }}</span>
            {%- endif -%}
            {%- if block.settings.flag_label != blank -%}
              <span class="pl-combo-flag-{{ sid }}">{{ block.settings.flag_label }}</span>
            {%- endif -%}

            <div class="pl-stack-{{ sid }}">
              {%- assign combo_products = p1, p2, p3, p4 -%}
              {%- assign combo_notes = block.settings.product_1_note, block.settings.product_2_note, block.settings.product_3_note, block.settings.product_4_note -%}
              {%- assign first_item = true -%}

              {%- for cp in combo_products -%}
                {%- if cp -%}
                  {%- unless first_item -%}
                    <span class="pl-plus" aria-hidden="true">+</span>
                  {%- endunless -%}
                  <span class="pl-sit">
                    {%- if cp.featured_image -%}
                      <img
                        src="{{ cp.featured_image | image_url: width: 120 }}"
                        alt="{{ cp.featured_image.alt | default: cp.title | escape }}"
                        width="60" height="66"
                        loading="lazy">
                    {%- else -%}
                      <span class="pl-sit-tile">
                        {%- render 'purelane-icon-leaf' -%}
                      </span>
                    {%- endif -%}
                    {%- assign cp_note = combo_notes[forloop.index0] -%}
                    {%- if cp_note != blank -%}
                      <span>{{ cp_note }}</span>
                    {%- else -%}
                      <span>{{ cp.title | truncate: 22 }}</span>
                    {%- endif -%}
                  </span>
                  {%- assign first_item = false -%}
                {%- endif -%}
              {%- endfor -%}
            </div>
          </div>

          {%- comment -%}── BODY ──{%- endcomment -%}
          <div class="pl-combo-body-{{ sid }}">
            {%- if block.settings.combo_name != blank -%}
              <h3>{{ block.settings.combo_name | escape }}</h3>
            {%- endif -%}

            {%- if block.settings.product_count_label != blank -%}
              <div class="pl-combo-cnt-{{ sid }}">{{ block.settings.product_count_label }}</div>
            {%- elsif products_in_block > 0 -%}
              <div class="pl-combo-cnt-{{ sid }}">{{ products_in_block }} product{% if products_in_block != 1 %}s{% endif %}</div>
            {%- endif -%}

            {%- if block.settings.description != blank -%}
              <div class="pl-combo-inc-{{ sid }}">{{ block.settings.description }}</div>
            {%- endif -%}

            <div class="pl-combo-prow-{{ sid }}">
              {%- if block.settings.price != blank -%}
                <strong>{{ block.settings.price }}</strong>
              {%- endif -%}
              {%- if block.settings.compare_price != blank -%}
                <s>{{ block.settings.compare_price }}</s>
              {%- endif -%}
              {%- if block.settings.savings_badge != blank -%}
                <em>{{ block.settings.savings_badge }}</em>
              {%- endif -%}
            </div>

            <div class="pl-combo-fine-{{ sid }}">Inclusive of all taxes · COD available</div>

            {%- if block.settings.cta_label != blank and block.settings.cta_url != blank -%}
              <a href="{{ block.settings.cta_url }}"
                class="pl-btn {% if block.settings.highlight %}pl-btn-primary{% else %}pl-btn-ghost{% endif %}"
                style="width:100%;justify-content:center;">
                {{ block.settings.cta_label }}
                {%- render 'purelane-icon-arrow' -%}
              </a>
            {%- endif -%}
          </div>

        </article>
      {%- endfor -%}

    </div>

    <div class="pl-swipecue-{{ sid }}" aria-hidden="true">
      {%- render 'purelane-icon-arrow' -%}
      Swipe for more combos
    </div>

    {%- if section.settings.rail_note != blank -%}
      <p class="pl-railnote-{{ sid }}">{{ section.settings.rail_note }}</p>
    {%- endif -%}

  </div>
</section>

{{ 'purelane-sections.js' | asset_url | script_tag }}

{% schema %}
{
  "name": "Purelane — Combos rail",
  "tag": "section",
  "class": "purelane-combos",
  "settings": [
    {
      "type": "header",
      "content": "Section header"
    },
    {
      "type": "text",
      "id": "kicker",
      "label": "Kicker label",
      "default": "Pre-built to save you money"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Best selling combos"
    },
    {
      "type": "text",
      "id": "subheading",
      "label": "Subheading",
      "default": "Swipe through the boxes people order most. Each one is already priced below buying the same products on their own."
    },
    {
      "type": "textarea",
      "id": "rail_note",
      "label": "Rail footnote",
      "default": "Tapping \"Shop bundle\" opens the bundle picker with these products already added. You can still swap anything before you pay."
    }
  ],
  "blocks": [
    {
      "type": "combo",
      "name": "Combo card",
      "settings": [
        {
          "type": "header",
          "content": "Card identity"
        },
        {
          "type": "text",
          "id": "combo_name",
          "label": "Combo name",
          "default": "Kitchen essentials"
        },
        {
          "type": "text",
          "id": "flag_label",
          "label": "Flag badge (leave blank to hide)",
          "placeholder": "Most popular",
          "info": "Appears as a coloured pill in the top-right of the product tray."
        },
        {
          "type": "text",
          "id": "save_label",
          "label": "Savings label",
          "default": "You save ₹398",
          "info": "Appears above the product stack."
        },
        {
          "type": "text",
          "id": "product_count_label",
          "label": "Product count label override",
          "placeholder": "3 products",
          "info": "Leave blank to auto-count based on products selected below."
        },
        {
          "type": "richtext",
          "id": "description",
          "label": "Description",
          "default": "<p>Includes a selection of our bestselling plant-based cleaners.</p>"
        },
        {
          "type": "checkbox",
          "id": "highlight",
          "label": "Highlight this card (gold border + primary CTA)",
          "default": false
        },
        {
          "type": "header",
          "content": "Products in combo (up to 4)"
        },
        {
          "type": "product",
          "id": "product_1",
          "label": "Product 1"
        },
        {
          "type": "text",
          "id": "product_1_note",
          "label": "Product 1 caption",
          "placeholder": "Cuts grease instantly"
        },
        {
          "type": "product",
          "id": "product_2",
          "label": "Product 2"
        },
        {
          "type": "text",
          "id": "product_2_note",
          "label": "Product 2 caption",
          "placeholder": "Squeaky clean dishes"
        },
        {
          "type": "product",
          "id": "product_3",
          "label": "Product 3"
        },
        {
          "type": "text",
          "id": "product_3_note",
          "label": "Product 3 caption",
          "placeholder": "Melts hard water stains"
        },
        {
          "type": "product",
          "id": "product_4",
          "label": "Product 4"
        },
        {
          "type": "text",
          "id": "product_4_note",
          "label": "Product 4 caption"
        },
        {
          "type": "header",
          "content": "Pricing"
